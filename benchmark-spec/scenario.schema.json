{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/agentinfrabench/scenario-1.0.0.json",
  "title": "AgentInfraBench scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "version", "workload", "operator", "run_at", "evidence", "economics"],
  "properties": {
    "platform": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "workload": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "run_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control", "dimension", "status", "provenance", "summary"],
        "properties": {
          "control": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["isolation", "identity_secrets", "network", "authority", "recovery", "observability", "economics"]},
          "status": {"enum": ["pass", "partial", "fail", "unknown"]},
          "provenance": {"enum": ["measured", "documented", "synthetic", "design"]},
          "summary": {"type": "string", "minLength": 1},
          "artifact": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "hard_gate": {"type": "boolean", "default": false}
        }
      }
    },
    "economics": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_outcomes", "infrastructure_usd", "model_usd", "storage_network_usd", "observability_usd", "human_review_hours", "human_hourly_usd", "operations_usd"],
      "properties": {
        "accepted_outcomes": {"type": "integer", "minimum": 1},
        "infrastructure_usd": {"type": "number", "minimum": 0},
        "model_usd": {"type": "number", "minimum": 0},
        "storage_network_usd": {"type": "number", "minimum": 0},
        "observability_usd": {"type": "number", "minimum": 0},
        "human_review_hours": {"type": "number", "minimum": 0},
        "human_hourly_usd": {"type": "number", "minimum": 0},
        "operations_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
